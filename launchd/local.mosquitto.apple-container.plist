<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>local.mosquitto.apple-container</string>
  <key>ProgramArguments</key>
  <array>
    <string>/opt/mosquitto/bin/mosquitto-container</string>
    <string>start</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>StartInterval</key>
  <integer>300</integer>
  <key>ProcessType</key>
  <string>Background</string>
  <key>StandardOutPath</key>
  <string>/tmp/local.mosquitto.apple-container.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/local.mosquitto.apple-container-error.log</string>
</dict>
</plist>
